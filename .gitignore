# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
# Editor and VCS conflict leftovers. These land next to the real file when a
# rebase, cherry-pick, or patch goes wrong, and are easy to commit by accident
# because they sit in real source directories.
*.orig
*.rej
*.bak

# ESLint's incremental cache, if anyone runs `eslint --cache`.
.eslintcache

# `vercel` CLI local state. Holds your personal project/org link, so it is
# machine-specific and not for the repo. (vercel.json IS tracked, intentionally.)
.vercel/

# OS
.DS_Store
Thumbs.db
# KDE/Nautilus desktop-entry marker, written into every folder you browse
.directory

# Environment
# Covers .env, .env.production, .env.staging, .env.*.local. The earlier
# `.env` + `.env.local` + `.env.*.local` set missed `.env.production` and
# `.env.staging`, which are exactly where a deploy secret ends up.
.env
.env.*
# direnv (used by some ROS/docker workflows locally).
.envrc

# TypeScript
*.tsbuildinfo

# Test files (too large for git)
test_files/
ros2-bagel-implementation-plan.md
walkthrough.md
.claude/settings.local.json

# Vitest output
coverage/

# Playwright output (traces on failure are uploaded by CI, not committed)
/test-results/
/playwright-report/
/blob-report/

# Improvements docs
IMPROVEMENTS.md
IMPROVEMENTS_PROGRESS.md

# Local video encodes and their poster frames (too large for git).
# Anchored to the repo root on purpose: public/demo_videos/*.mp4 are tracked
# app assets served at runtime, so a bare *.mp4 rule would block new ones.
/BAGEL-*.mp4
/BAGEL-*.jpg
/videos/

# Local agent and planning files. Each developer's own; not part of the project.
.codex/
.claude/
ROADMAP_UPGRADES.md
AGENTS.md
