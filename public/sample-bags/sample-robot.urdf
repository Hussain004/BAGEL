<?xml version="1.0" encoding="UTF-8"?>
<!--
  BAGEL sample robot - v1.3.0

  A primitives-only URDF that pairs with the bundled `tour.mcap` (which
  publishes /tf with base_link, laser, and imu_link). The robot's anchor
  link is `base_link` so when the bag's odom -> base_link TF is composed
  through, the model rides along with the trajectory.

  Continuous wheel joints are present so the model is "animated-ready":
  if you drop a bag that publishes /joint_states for the same joint names,
  the wheels turn at the playhead. Tour.mcap doesn't, so they sit at rest -
  which is exactly what the URDF rest pose looks like.

  Mesh-free by design: a fresh checkout serves this without also serving
  any package:// resource folders.
-->
<robot name="bagel_sample_robot">

  <material name="body">
    <color rgba="0.18 0.42 0.78 1.0"/>
  </material>
  <material name="wheel">
    <color rgba="0.10 0.10 0.12 1.0"/>
  </material>
  <material name="laser">
    <color rgba="1.00 0.42 0.20 1.0"/>
  </material>
  <material name="imu">
    <color rgba="0.20 0.78 0.42 1.0"/>
  </material>
  <material name="trim">
    <color rgba="0.62 0.62 0.66 1.0"/>
  </material>

  <!-- Robot body -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.42 0.30 0.10"/>
      </geometry>
      <material name="body"/>
    </visual>
    <visual>
      <!-- A small front bumper so the heading direction is obvious. -->
      <origin xyz="0.22 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.30 0.04"/>
      </geometry>
      <material name="trim"/>
    </visual>
  </link>

  <!-- Four wheels, continuous joints so /joint_states drives them. -->
  <link name="wheel_fl">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="wheel"/>
    </visual>
  </link>
  <joint name="base_to_wheel_fl" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fl"/>
    <origin xyz="0.16 0.17 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_fr">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="wheel"/>
    </visual>
  </link>
  <joint name="base_to_wheel_fr" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fr"/>
    <origin xyz="0.16 -0.17 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rl">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="wheel"/>
    </visual>
  </link>
  <joint name="base_to_wheel_rl" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rl"/>
    <origin xyz="-0.16 0.17 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_rr">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="wheel"/>
    </visual>
  </link>
  <joint name="base_to_wheel_rr" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rr"/>
    <origin xyz="-0.16 -0.17 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Sensor mount pillar so the laser sits above the body, like a small AMR. -->
  <link name="sensor_mount">
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.16"/>
      </geometry>
      <material name="trim"/>
    </visual>
  </link>
  <joint name="base_to_mount" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_mount"/>
    <origin xyz="0.0 0.0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- Laser - matches /tf static `base_link -> laser` published by tour.mcap. -->
  <link name="laser">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
      <material name="laser"/>
    </visual>
  </link>
  <joint name="mount_to_laser" type="fixed">
    <parent link="sensor_mount"/>
    <child link="laser"/>
    <origin xyz="0.0 0.0 0.18" rpy="0 0 0"/>
  </joint>

  <!-- IMU - matches /tf static `base_link -> imu_link` published by tour.mcap. -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.02"/>
      </geometry>
      <material name="imu"/>
    </visual>
  </link>
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.10 0.11" rpy="0 0 0"/>
  </joint>

</robot>
