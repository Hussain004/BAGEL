<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="leg_len" value="0.3"/>
  <xacro:macro name="leg" params="side parent">
    <link name="${side}_leg">
      <visual><geometry><box size="0.05 0.05 ${leg_len}"/></geometry></visual>
    </link>
    <joint name="${side}_hip" type="revolute">
      <parent link="${parent}"/><child link="${side}_leg"/>
      <origin xyz="0 ${0.1 if side == 'left' else -0.1} 0"/>
      <limit lower="${-pi/4}" upper="${pi/4}" effort="5" velocity="1"/>
    </joint>
  </xacro:macro>
</robot>
